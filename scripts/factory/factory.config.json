{
  "_doc": "BSC Story Factory production controls. Used by scripts/factory/*.ts — automatically every day by .github/workflows/story-factory.yml, or by hand. Visitors never call Gemini or ComfyUI.",
  "model": "gemini-3.5-flash-lite",
  "concepts": 2,
  "modes": {
    "classic": 0.5,
    "marine": 0.5
  },
  "tones": {
    "adventure": 1,
    "mystery": 1,
    "suspense": 1,
    "comedy": 1,
    "investigation": 1,
    "strange": 1
  },
  "environments": {
    "classic": [
      "forest",
      "mountain",
      "desert",
      "cave",
      "snow",
      "swamp",
      "ruins",
      "lab"
    ],
    "marine": [
      "reef",
      "mudflat",
      "seagrass",
      "openSea",
      "twilight",
      "midnight",
      "vents",
      "trench"
    ]
  },
  "graph": {
    "minNodes": 5,
    "maxNodes": 9,
    "endings": 3,
    "maxDepth": 7,
    "choicesPerNode": {
      "open": 4,
      "gatedMax": 2
    }
  },
  "rareEncounterRate": 0.15,
  "art": {
    "maxNewPlatesPerStory": 4,
    "batchSeedStart": 20000,
    "requireExistingPlates": false
  },
  "budget": {
    "maxRequests": 30,
    "maxOutputTokensPerRequest": 32000,
    "maxTotalTokens": 1500000,
    "repairAttempts": 2,
    "minSecondsBetweenRequests": 20
  },
  "quality": {
    "maxErrors": 0,
    "maxWarnings": 6,
    "minDistinctPaths": 3,
    "maxSimilarity": 0.45,
    "minAvgScenes": 4
  },
  "auto": {
    "_doc": "Used by .github/workflows/story-factory.yml (weekly, no human review). A story is published only with 0 validator errors AND every editor score >= minReviewScore; otherwise it stays hidden in 'review'.",
    "schedule": "every day 12:00 Kuwait time (after the quota reset)",
    "perRun": {
      "classic": 3,
      "marine": 3
    },
    "minReviewScore": 8,
    "reviseOnce": true
  },
  "reviewModel": "gemini-3.5-flash"
}